#!/usr/bin/env bash
set -euo pipefail

real_adb="${MUXTV_REAL_ADB:-${ANDROID_HOME:-}/platform-tools/adb}"
max_attempts="${MUXTV_ADB_RETRY_ATTEMPTS:-6}"
retry_delay_seconds="${MUXTV_ADB_RETRY_DELAY_SECONDS:-2}"

if [[ -z "${real_adb}" || ! -x "${real_adb}" ]]; then
  echo "MuxTV adb shim: real adb is not executable: ${real_adb:-<empty>}" >&2
  exit 127
fi
if ! [[ "$max_attempts" =~ ^[1-9][0-9]*$ ]]; then
  echo "MuxTV adb shim: MUXTV_ADB_RETRY_ATTEMPTS must be a positive integer." >&2
  exit 2
fi

joined_args=" $* "
silent_255_retry_allowed=false
if [[ "$joined_args" == *" shell getprop sys.boot_completed "* ]] ||
   [[ "$joined_args" == *" shell input keyevent 82 "* ]] ||
   [[ "$joined_args" == *" shell settings put "* ]]; then
  silent_255_retry_allowed=true
fi

for ((attempt = 1; attempt <= max_attempts; attempt++)); do
  stdout_file="$(mktemp)"
  stderr_file="$(mktemp)"
  set +e
  "$real_adb" "$@" >"$stdout_file" 2>"$stderr_file"
  status=$?
  set -e

  if (( status == 0 )); then
    cat "$stdout_file"
    cat "$stderr_file" >&2
    rm -f "$stdout_file" "$stderr_file"
    exit 0
  fi

  output="$(cat "$stdout_file"; cat "$stderr_file")"
  transient=false
  if grep -Eqi "^adb: device .*offline$|^adb: device .*not found$|^error: no devices/emulators found$|cannot connect to adb daemon|^\* daemon not running" <<<"$output"; then
    transient=true
  elif (( status == 255 )) && [[ "$silent_255_retry_allowed" == true ]]; then
    transient=true
  fi

  if [[ "$transient" != true ]] || (( attempt == max_attempts )); then
    cat "$stdout_file"
    cat "$stderr_file" >&2
    rm -f "$stdout_file" "$stderr_file"
    exit "$status"
  fi

  cat "$stdout_file" >&2
  cat "$stderr_file" >&2
  rm -f "$stdout_file" "$stderr_file"
  echo "MuxTV adb shim: transient transport failure (attempt ${attempt}/${max_attempts}); retrying." >&2
  sleep "$retry_delay_seconds"
done
